# GEMINI_API_KEY: Required for Gemini AI API calls (unused by static site unless extended).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000).
PORT=3000

# WEB3FORMS_ACCESS_KEY: Browser-side Web3Forms access key for membership (/membership/apply/) and contact (/contact/) forms.
WEB3FORMS_ACCESS_KEY=""

# WEB3FORMS_PUBLICATION_ACCESS_KEY: Browser-side Web3Forms access key for article submissions (/contribute/submit/).
WEB3FORMS_PUBLICATION_ACCESS_KEY=""

# Optional newsletter endpoint and access key (when configured, renders the footer newsletter signup form).
WEB3FORMS_NEWSLETTER_ENDPOINT=""
WEB3FORMS_NEWSLETTER_ACCESS_KEY=""
